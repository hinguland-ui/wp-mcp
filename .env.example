# सब सर्विस (web + api + mcp) इसी एक फ़ाइल से चलती हैं.
# Local: `npm run setup` इसे .env में कॉपी करके secrets भर देता है.
# Hosting: यही variables hosting panel के "Environment variables" में डालें (या .env फ़ाइल रखें).

# ── MySQL ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wpconnect
DB_USER=root
DB_PASSWORD=

# ── Production (एक domain पर deploy) ──
# सिर्फ़ अपना domain डालें. बाकी URLs (site, /v1 API, /mcp) इसी से बन जाते हैं.
# PUBLIC_URL=https://yourdomain.com

# ── Local development URLs (npm run web) ──
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://127.0.0.1:4000
MCP_PUBLIC_URL=http://127.0.0.1:4100
API_INTERNAL_URL=http://127.0.0.1:4000

# ── Secrets (setup अपने आप बना देता है; production में भी लंबे random मान ज़रूरी) ──
JWT_SECRET=CHANGE_ME
INTERNAL_API_KEY=CHANGE_ME
SITE_SECRET_ENCRYPTION_KEY=CHANGE_ME

JWT_EXPIRES_IN=1h
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300
